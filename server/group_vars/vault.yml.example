---
# Шаблон секретов. Скопируй в vault.yml и зашифруй:
#
#   cp group_vars/vault.yml.example group_vars/vault.yml
#   $EDITOR group_vars/vault.yml
#   ansible-vault encrypt group_vars/vault.yml
#
# После этого запускай плейбуки с --ask-vault-pass (или --vault-password-file).
# vault.yml уже в .gitignore — в git он попадать не должен.

# Ключ доступа Cloud.ru Object Storage в формате <tenant_id>:<key_id>
s3_access_key_id: "<tenant_id>:<key_id>"
s3_secret_access_key: "<key_secret>"

# Пароль restic-репозитория (один на оба хоста). Потеряешь — бэкапы мусор.
restic_password: "<сильный-пароль>"

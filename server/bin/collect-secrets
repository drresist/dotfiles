#!/usr/bin/env bash
#
# collect-secrets — собрать все ключи/креды трёх хостов в один зашифрованный архив.
#
#   ./bin/collect-secrets                       # спросит парольную фразу, положит в ~/secret-bundle
#   OUT_DIR=/mnt/usb ./bin/collect-secrets      # другой каталог назначения
#   BUNDLE_PASSPHRASE=... ./bin/collect-secrets # без интерактива (cron/автоматизация)
#
# Результат: <OUT_DIR>/secrets-bundle-<YYYYmmdd-HHMM>.tar.gz.gpg (0600)
# Внутри: README.md + каталог на каждый хост (пути повторяют пути на хосте без ведущего '/').
#
# Секреты никогда не печатаются на stdout и не остаются на диске в открытом виде:
# всё собирается в mktemp-каталог 0700, который удаляется при выходе.
#
# Источники: omamac (локально), cloudcode (ssh, без sudo), proxy (ssh + sudo -n).
# Часть файлов на cloudcode доступна только root — они честно попадут в GAPS.txt.

set -euo pipefail
umask 077

OUT_DIR="${OUT_DIR:-$HOME/secret-bundle}"
CLOUDCODE_TARGET="${CLOUDCODE_TARGET:-cloudcode}"
PROXY_TARGET="${PROXY_TARGET:-100.121.120.33}"
SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=yes)

STAMP="$(date +%Y%m%d-%H%M)"

die() { printf 'collect-secrets: %s\n' "$*" >&2; exit 1; }
say() { printf '%s\n' "$*" >&2; }

command -v gpg >/dev/null 2>&1 || die "нужен gpg"
command -v tar >/dev/null 2>&1 || die "нужен tar"
mkdir -p "$OUT_DIR" && chmod 700 "$OUT_DIR"

WORK="$(mktemp -d)"
chmod 700 "$WORK"
trap 'rm -rf "$WORK"' EXIT
mkdir -p "$WORK/bundle"

# ---------------------------------------------------------------- часть на хосте

stage_lib() {
	cat <<'LIB'
# === выполняется на хосте-источнике ===
set -euo pipefail
stage="$(mktemp -d)"
trap 'rm -rf "$stage"' EXIT
gaps="$stage/GAPS.txt"
: > "$gaps"

note() { printf '%s\n' "$*" >&2; }

# copy <путь-или-глоб>: копирует всё, что существует; чего нет — в GAPS.txt
copy() {
	local pattern="$1" f hit=0 rel
	for f in $pattern; do
		[ -e "$f" ] || continue
		hit=1
		rel="${f#/}"
		mkdir -p "$stage/$(dirname "$rel")"
		if cp -a -- "$f" "$stage/$rel" 2>/dev/null; then
			:
		else
			rm -rf "$stage/$rel"
			printf 'НЕ ПРОЧИТАЛОСЬ (нужен root): %s\n' "$f" >> "$gaps"
			note "не прочиталось: $f"
		fi
	done
	[ "$hit" = 1 ] || { printf 'НЕТ: %s\n' "$pattern" >> "$gaps"; note "нет: $pattern"; }
}

# snapshot_sqlite <живая-база> <путь-в-архиве>: консистентный слепок живой SQLite
snapshot_sqlite() {
	local src="$1" rel="$2" dest
	dest="$stage/$rel"
	if [ ! -f "$src" ]; then
		printf 'НЕТ: %s\n' "$src" >> "$gaps"
		note "нет: $src"
		return 0
	fi
	mkdir -p "$(dirname "$dest")"
	if command -v sqlite3 >/dev/null 2>&1; then
		sqlite3 "$src" ".backup '$dest'"
	else
		python3 - "$src" "$dest" <<'PY'
import sqlite3, sys
src, dst = sys.argv[1], sys.argv[2]
s = sqlite3.connect("file:%s?mode=ro" % src, uri=True)
d = sqlite3.connect(dst)
with d:
    s.backup(d)
d.close()
s.close()
PY
	fi
	note "sqlite-слепок: $src"
}

# dump_crontab <метка>
dump_crontab() {
	if crontab -l > "$stage/CRON-$1.txt" 2>/dev/null; then
		:
	else
		printf '(crontab недоступен или пуст)\n' > "$stage/CRON-$1.txt"
	fi
}

# dump_repo_env <env-файл>: только несекретные параметры репозитория
dump_repo_env() {
	local envfile="$1" out="$stage/RESTIC-REPOS.txt"
	{
		printf '# из %s\n' "$envfile"
		grep -E '^(export )?(S3_REPOSITORY|AWS_DEFAULT_REGION)=' "$envfile" 2>/dev/null ||
			printf '(файла нет)\n'
	} >> "$out"
}

# container_copy <контейнер>: конфиги и ключи из контейнера (Amnezia держит их
# в /opt/amnezia внутри образа, на хосте только Dockerfile'ы)
container_copy() {
	local c="$1" rel="docker-containers/$1" list
	if ! docker inspect "$c" >/dev/null 2>&1; then
		printf 'НЕТ КОНТЕЙНЕРА: %s\n' "$c" >> "$gaps"
		note "нет контейнера: $c"
		return 0
	fi
	mkdir -p "$stage/$rel"
	list=$(docker exec "$c" sh -c \
		'for p in "$@"; do if [ -e "$p" ]; then printf "%s\n" "$p"; fi; done' \
		sh /opt/amnezia /etc/3proxy /etc/ipsec.conf /etc/ipsec.secrets /etc/ipsec.d /etc/wireguard 2>/dev/null || true)
	if [ -z "$list" ]; then
		printf 'ПУСТО (нечего выгрузить): %s\n' "$c" >> "$gaps"
		note "пусто: $c"
		rmdir "$stage/$rel"
		return 0
	fi
	docker exec "$c" tar -cf - -C / $list | tar -xf - -C "$stage/$rel"
	note "контейнер: $c"
}

# finish <имя-хоста>: манифест + tar в stdout
finish() {
	local host="$1" count
	{
		printf '# %s\n# path\tsize\n' "$host"
		find "$stage" -type f ! -name MANIFEST.tsv -printf '%P\t%s\n'
	} | sort > "$stage/MANIFEST.tsv"
	count=$(( $(wc -l < "$stage/MANIFEST.tsv") - 2 ))
	note "файлов: $count, объём: $(du -sh "$stage" | cut -f1)"
	tar -C "$stage" -czf - .
}
LIB
}

script_omamac() {
	stage_lib
	cat <<'HOST'
H="$HOME"
copy "$H/.config/restic/password"
copy "$H/.config/snx-rs/snx-rs.conf"
copy "$H/.config/gh/hosts.yml"
copy "$H/.config/gh/config.yml"
copy "$H/.config/mihomo/config.yaml"
copy "$H/.codex/auth.json"
copy "$H/.codex/config.toml"
copy "$H/.omp/agent/config.yml"
copy "$H/.omp/agent/mcp.json"
copy "$H/.config/opencode/opencode.json"
copy "$H/.config/opencode/tui.json"
copy "$H/.ssh/authorized_keys"
copy "$H/.ssh/known_hosts"
copy "$H/.ssh/known_hosts.old"
copy "$H/Projects/dotfiles/server/group_vars/all.yml"
copy "$H/Projects/dotfiles/server/group_vars/vault.yml"
dump_crontab omamac
finish omamac
HOST
}

script_cloudcode() {
	stage_lib
	cat <<'HOST'
H="$HOME"
# restic: креды S3 и пароль репозитория
copy "$H/backups/s3.env"
copy "$H/backups/s3.env.bak-*"
copy "$H/backups/backup.sh"
copy "$H/backups/verify-restore.sh"
copy "$H/.config/restic/password"
# ssh: собственные ключи хоста + выделенный ключ к SFTP-репозиторию на proxy
copy "$H/.ssh/id_ed25519"
copy "$H/.ssh/id_ed25519.pub"
copy "$H/.ssh/id_ed25519_backup"
copy "$H/.ssh/id_ed25519_backup.pub"
copy "$H/.ssh/config"
copy "$H/.ssh/authorized_keys"
copy "$H/.ssh/known_hosts"
# сервисы
copy "$H/cloudcode-homepage/.env"
copy "$H/cloudcode-homepage/compose.yaml"
copy "$H/cloudcode-homepage/config/services.yaml"
copy "$H/proxy-monitoring/compose.yaml"
copy "$H/proxy-monitoring/config.yaml"
copy "/opt/n8n/compose.yaml"
copy "/opt/agent-memory/compose.yaml"
copy "/DATA/AppData/n8n/config"
snapshot_sqlite "/DATA/AppData/n8n/database.sqlite" "DATA/AppData/n8n/database.sqlite"
snapshot_sqlite "$H/proxy-monitoring/data/gatus.db" "home/mfesenko/proxy-monitoring/data/gatus.db"
# root-only: напрямую не читается → в GAPS.txt. Если сложить их в ~/root-dump
# (команда — в README архива и в server/README.md), попадут в архив.
copy "/opt/dockhand"
copy "/etc/rclone"
copy "$H/root-dump"
dump_crontab cloudcode
dump_repo_env "$H/backups/s3.env"
finish cloudcode
HOST
}

script_proxy() {
	stage_lib
	cat <<'HOST'
# restic (всё под root) + ключи restic-репозитория
copy "/root/backups/s3.env"
copy "/root/backups/s3.env.bak-*"
copy "/root/backups/restic-password"
copy "/root/backups/backup.sh"
copy "/root/backups/verify-restore.sh"
# x-ui: консистентный слепок живой панели + прежние снапшоты
snapshot_sqlite "/etc/x-ui/x-ui.db" "etc/x-ui/x-ui.db"
copy "/etc/x-ui/x-ui.db.bak-*"
copy "/etc/x-ui/install-result.env"
# marzban
copy "/var/lib/marzban/db.sqlite3"
copy "/var/lib/marzban/xray_config.json"
copy "/opt/marzban/.env"
copy "/opt/marzban/docker-compose.yml"
# VPN/proxy: ключи клиентов, конфиги, сертификаты
copy "/opt/amnezia"
copy "/etc/wireguard"
copy "/etc/host-firewall.nft"
copy "/root/cert"
copy "/root/.acme.sh/account.conf"
copy "/root/.acme.sh/ca"
copy "/root/.acme.sh/*_ecc"
copy "/root/cobalt/docker-compose.yml"
copy "/root/3proxy/docker-compose.yml"
copy "/var/lib/docker/volumes/amnezia-mtproxy-data"
copy "/var/lib/docker/volumes/amnezia-telemt-data"
# ключи клиентов Amnezia лежат внутри контейнеров, а не на хосте
for c in amnezia-wireguard amnezia-awg amnezia-awg2 amnezia-openvpn \
	amnezia-shadowsocks amnezia-xray amnezia-socks5proxy amnezia-ipsec amnezia-dns; do
	container_copy "$c"
done
# ssh: host-ключи хоста, доступ, конфиг sshd
copy "/etc/ssh/ssh_host_*"
copy "/etc/ssh/sshd_config"
copy "/etc/ssh/sshd_config.d"
copy "/root/.ssh"
copy "/home/mfesenko/.ssh"
dump_crontab proxy
dump_repo_env "/root/backups/s3.env"
finish proxy
HOST
}

# ------------------------------------------------------------------- сбор с хостов

gather() { # <метка> <local|ssh-цель> <функция-генератор> <префикс-команды-на-хосте>
	local label="$1" target="$2" fn="$3" remote_cmd="${4:-bash}"
	local log="$WORK/$label.log" dir="$WORK/bundle/$label"
	mkdir -p "$dir"
	say "→ $label ($target)"
	# --no-same-permissions: каталоги вида drw-rw---- (например /etc/wireguard)
	# иначе не дают распаковать себя непривилегированному пользователю
	if [ "$target" = local ]; then
		"$fn" | bash -s 2>"$log" | tar -xzf - --no-same-owner --no-same-permissions -C "$dir"
	else
		"$fn" | ssh "${SSH_OPTS[@]}" "$target" "$remote_cmd -s" 2>"$log" |
			tar -xzf - --no-same-owner --no-same-permissions -C "$dir"
	fi
	# каталоги вида drw-rw---- (например /etc/wireguard) после распаковки
	# не обходятся владельцем — права нормализуем к «только владелец»
	chmod -R u+rwX,go-rwx "$dir"
	# всё, что хост заявил в манифесте, должно быть на месте
	local rel missing=()
	while IFS=$'\t' read -r rel _; do
		case "$rel" in '#'*|'') continue ;; esac
		[ -e "$dir/$rel" ] || missing+=("$rel")
	done < "$dir/MANIFEST.tsv"
	[ "${#missing[@]}" = 0 ] || die "$label: не распаковалось: ${missing[*]}"
	local files gaps
	files=$(find "$dir" -type f | wc -l)
	gaps=$(grep -c . "$dir/GAPS.txt" 2>/dev/null || true)
	say "  файлов: $files, пробелов: ${gaps:-0}"
	if [ "${gaps:-0}" != 0 ]; then
		sed 's/^/  · /' "$dir/GAPS.txt" >&2
	fi
}

# ---------------------------------------------------------------------- парольная фраза

PASS="${BUNDLE_PASSPHRASE:-}"
if [ -z "$PASS" ]; then
	IFS= read -rs -p 'Парольная фраза для архива: ' PASS
	printf '\n' >&2
	IFS= read -rs -p 'Повтори: ' PASS2
	printf '\n' >&2
	[ "$PASS" = "$PASS2" ] || die "фразы не совпали"
	unset PASS2
fi
[ "${#PASS}" -ge 12 ] || die "парольная фраза короче 12 символов"

say "собираю секреты (в открытом виде ничего не остаётся)..."
gather omamac local script_omamac
gather cloudcode "$CLOUDCODE_TARGET" script_cloudcode bash
gather proxy "$PROXY_TARGET" script_proxy "sudo -n bash"

# ------------------------------------------------------------------------ README

readme() {
	local out="$WORK/bundle/README.md"
	{
		printf '# Секреты хостов — bundle %s\n\n' "$STAMP"
		cat <<'HEAD'
Собрано `server/bin/collect-secrets`. Внутри — ключи, пароли и конфиги, без которых
не восстановить хосты и restic-репозитории. Архив зашифрован симметрично (gpg AES256),
парольная фраза задаётся при сборке и нигде в архиве не хранится.

## Как распаковать

```bash
mkdir -p ~/secrets && gpg -d secrets-bundle-*.tar.gz.gpg | tar xzf - -C ~/secrets
```

Права внутри архива уже «только владелец» (0600/0700), отдельный chmod не нужен.

Пути внутри архива повторяют пути на хосте без ведущего `/`:
`proxy/root/backups/s3.env` → `/root/backups/s3.env`,
`cloudcode/home/mfesenko/backups/s3.env` → `/home/mfesenko/backups/s3.env`.

## Что где лежит

| Файл в архиве | Что это | Куда возвращать |
|---|---|---|
| `<host>/MANIFEST.tsv` | полный список файлов с размерами | — |
| `<host>/GAPS.txt` | что не удалось собрать | — |
| `<host>/RESTIC-REPOS.txt` | endpoint/регион/имя репозитория (не секрет) | — |
| `*/backups/s3.env` | S3-ключи Cloud.ru + адрес репозитория | `/root/backups/s3.env` (proxy), `~/backups/s3.env` (cloudcode) |
| `*/restic-password` | пароль restic-репозиториев (общий) | `/root/backups/restic-password`, `~/.config/restic/password` |
| `cloudcode/home/mfesenko/.ssh/id_ed25519_backup` | SFTP-ключ к репозиторию на proxy (restricted) | `~/.ssh/` |
| `cloudcode/DATA/AppData/n8n/config` | `N8N_ENCRYPTION_KEY` (без него credentials n8n нечитаемы) | тот же путь |
| `cloudcode/DATA/AppData/n8n/database.sqlite` | слепок базы n8n (workflows/credentials) | тот же путь |
| `proxy/etc/x-ui/x-ui.db` | слепок панели x-ui (доступы + inbounds) | `/etc/x-ui/x-ui.db` |
| `proxy/var/lib/marzban/db.sqlite3` | база Marzban (пользователи/подписки) | тот же путь |
| `proxy/docker-containers/<контейнер>/**` | ключи и конфиги Amnezia из самих контейнеров: WG/AWG private+psk и clientsTable, OVPN CA/сертификаты клиентов, IPsec (`.p12` клиентов, `cert9.db`/`key4.db`), Shadowsocks, Xray (REALITY-ключи, uuid), 3proxy | контейнеры восстанавливаются Amnezia-панелью; файлы — ориентир для воссоздания клиентов |
| `proxy/var/lib/docker/volumes/amnezia-{mtproxy,telemt}-data/**` | данные MTProto-контейнеров (секреты, клиентские ссылки) | тома docker |
| `proxy/opt/amnezia/**` | только Dockerfile'ы (ключей там нет — они внутри контейнеров) | — |
| `<host>/CRON-*.txt` | crontab хоста (расписание бэкапов и ACME) | — |
| `proxy/root/.acme.sh/**` | ACME-аккаунт и LE-сертификат на IP | тот же путь |
| `proxy/etc/ssh/ssh_host_*` | host-ключи proxy | тот же путь |
| `omamac/.../snx-rs.conf` | креды Fortinet VPN | `~/.config/snx-rs/` |
| `omamac/.../.config/restic/password` | вторая копия пароля restic | `~/.config/restic/password` |

## Восстановление restic

Пароль — `restic-password` (он же `.config/restic/password`), ключи — `s3.env`.
Репозитории и их адреса перечислены ниже; проверка:

```bash
set -a; . ./s3.env; set +a
export RESTIC_PASSWORD_FILE=./restic-password
restic -r "$S3_REPOSITORY" snapshots
restic -r "$S3_REPOSITORY" restore latest --target /tmp/restore
```

Ключи S3 должны позволять List/Get/Put/Delete (иначе `forget --prune` не отработает).
В двух `s3.env` (cloudcode и proxy) ключи одинаковые, отличается только `S3_REPOSITORY`;
ротация — сразу в обоих файлах (`./bin/ops rotate-s3`).
SFTP-копия репозитория cloudcode доступна как `sftp:proxy-backup:/home/mfesenko/backups/restic-cloudcode`
(алиас `proxy-backup` есть в `cloudcode/home/mfesenko/.ssh/config`, ключ — в этом же архиве).

## Адреса репозиториев

```
HEAD
		cat "$WORK/bundle/cloudcode/RESTIC-REPOS.txt" 2>/dev/null || true
		cat "$WORK/bundle/proxy/RESTIC-REPOS.txt" 2>/dev/null || true
		cat <<'TAIL'
```

## Что не попало и почему

- Файлы, помеченные в `GAPS.txt` как «НЕ ПРОЧИТАЛОСЬ (нужен root)»: на cloudcode у
  пользователя `mfesenko` нет sudo (только консоль провайдера). Это `/opt/dockhand`
  и `/etc/rclone` (`rclone.env`, 0600) — забрать можно, только зайдя на хост рутом.
  Если они нужны в архиве, один раз под root в консоли провайдера:

  ```bash
  install -d -m 700 /home/mfesenko/root-dump &&
  cp -a /opt/dockhand /etc/rclone /home/mfesenko/root-dump/ &&
  cp -a /var/lib/docker/volumes/dockhand_dockhand_data /home/mfesenko/root-dump/ &&
  chown -R mfesenko:mfesenko /home/mfesenko/root-dump
  ```

  после этого `~/root-dump` подхватывается коллектором в следующий прогон.
  `docker inspect dockhand` доступен и без root (в env секретов нет: только
  `PORT`/`HOST`/`PUID`/`PGID` и монтирование docker.sock).
- Приватные SSH-ключи, которыми ты ходишь на хосты с omamac, лежат в Bitwarden
  (SSH agent), а не на диске. Корень доверия — Bitwarden: мастер-пароль и
  recovery-код 2FA. Этот архив стоит положить туда же вложением.
- Остановленные контейнеры (`amnezia-openvpn-cloak`, `cobalt`, `3proxy-3proxy-1`)
  не выгружались: их ключи — легаси. Конфиг Compose от 3proxy и cobalt лежит в
  `proxy/root/`.
- `/root/.bash_history`, `/root/.viminfo`, `.lesshst` не включены намеренно:
  это история команд, а не ключи; в ней могут быть разовые секреты.
- Важно: restic-снапшоты **не покрывают** ключи внутри Amnezia-контейнеров —
  роль `restic_backup` для proxy архивирует `/opt/amnezia`, где лежат только
  Dockerfile'ы. Единственная копия этих ключей — этот bundle.
- Состояние tailscale (`tailscale serve` 443/8443 на cloudcode) не выгружено:
  восстанавливается командами `tailscale serve` заново.

## Пересобрать

```bash
~/Projects/dotfiles/server/bin/collect-secrets
```
TAIL
	} > "$out"
}

readme

# ---------------------------------------------------------------------- шифрование

tar -C "$WORK/bundle" -czf "$WORK/bundle.tar.gz" .
OUT="$OUT_DIR/secrets-bundle-$STAMP.tar.gz.gpg"

printf '%s\n' "$PASS" |
	gpg --batch --yes --pinentry-mode loopback --passphrase-fd 0 \
		--symmetric --cipher-algo AES256 --s2k-mode 3 --s2k-count 65011712 \
		--compress-algo none -o "$OUT" "$WORK/bundle.tar.gz"
chmod 600 "$OUT"

# ---------------------------------------------- самопроверка: расшифровывается и совпадает

printf '%s\n' "$PASS" |
	gpg --batch --yes --pinentry-mode loopback --passphrase-fd 0 --decrypt "$OUT" 2>/dev/null |
	tar tzf - | grep -v '/$' | sort -u > "$WORK/verify.list"
unset PASS

( cd "$WORK/bundle" && find . -type f | sort ) > "$WORK/expect.list"
diff -q "$WORK/expect.list" "$WORK/verify.list" >/dev/null ||
	die "архив не совпадает с собранным деревом — не используй его"

say ""
say "готово: $OUT"
say "размер: $(du -h "$OUT" | cut -f1), файлов внутри: $(wc -l < "$WORK/expect.list")"
say "sha256: $(sha256sum "$OUT" | cut -d' ' -f1)"
say ""
say "дальше: положить архив в Bitwarden (вложение), а парольную фразу — в запись."
say "посмотреть содержимое: gpg -d '$OUT' | tar tzf -"
